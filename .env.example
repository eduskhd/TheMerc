# =============================================================================
# THE MERC — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# SQUARE — ONLINE ORDERING (Phase 1)
# ---------------------------------------------------------------------------
# Set this to your Square Online ordering page URL.
# If empty, the "Order Online" button shows a "Coming Soon" state.
# Example: https://order.squareup.com/preview/YOUR_LOCATION_ID
NEXT_PUBLIC_SQUARE_ORDER_URL=

# ---------------------------------------------------------------------------
# SQUARE — API INTEGRATION (Phase 2 - Future)
# ---------------------------------------------------------------------------
# These are ONLY used server-side (API routes). Never expose to the client.
# Required for: Square Catalog, Orders, and Checkout API integration.

# Your Square Application ID (starts with sq0idp- for production, sandbox-sq0idp- for sandbox)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=

# Your Square Access Token — SERVER-SIDE ONLY. Never use NEXT_PUBLIC_ prefix.
SQUARE_ACCESS_TOKEN=

# Your Square Location ID
SQUARE_LOCATION_ID=

# Square Environment: 'sandbox' or 'production'
SQUARE_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# SANITY CMS — CONTENT MANAGEMENT
# ---------------------------------------------------------------------------
# Get these values from https://sanity.io/manage after creating a project.
# The Project ID is public (safe to expose). The dataset is usually "production".

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# SITE (optional)
# ---------------------------------------------------------------------------
# Base URL for Open Graph and canonical URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
